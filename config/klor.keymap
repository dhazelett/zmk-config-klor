// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

/* TEMPLATE
          ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
          │         │         │         │         │         │                    │         │         │         │         │         │
┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
│         │         │         │         │         │         │                    │         │         │         │         │         │         │
├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
│         │         │         │         │         │         ││        ││        ││         │         │         │         │         │         │
└─────────┴─────────┴─────────┼─────────┼─────────┼─────────┘╰────────╯╰────────╯└─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                              │         │         │         │         ││         │         │         │         │
                              └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘
bindings = <
          &trans    &trans    &trans    &trans    &trans                         &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans                         &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans
                              &trans    &trans    &trans    &trans     &trans    &trans    &trans    &trans
>;
*/

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>


#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3


/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
    };



    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label= "BASE";
            /*
                      ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
                      │    Q    │    W    │    E    │    R    │    T    │                    │    Y    │    U    │    I    │    O    │    P    │
            ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
            │   N/C   │    A    │    S    │    D    │    F    │    G    │                    │         │    H    │    J    │    K    │    L    │   N/C   │
            ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
            │   N/C   │    Z    │    X    │    C    │    V    │    B    ││   N/C  ││   N/C  ││         │    N    │    M    │         │  SHIFT  │   N/C   │
            └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┘╰────────╯╰────────╯└─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                          │  CTRL   │  LOWER  │  SPACE  │   N/C   ││   N/C   │  ENTER  │  RAISE  │  BSPCE  │
                                          └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘
            */
            bindings = <
                      &kp Q     &kp W     &kp E     &kp R     &kp T                          &kp Y     &kp U     &kp I     &kp O     &kp P
            &kp TAB   &kp A     &kp S     &kp D     &kp F     &kp G                          &trans    &kp H     &kp J     &kp K     &kp L     &trans
            &kp DEL   &kp Z     &kp X     &kp C     &kp V     &kp B     &trans   &trans      &trans    &kp N     &kp M     &trans   &kp LSHIFT &trans
                                          &kp LCTRL &mo LOWER &kp SPACE &trans   &trans      &kp RET   &mo RAISE &kp BSPC
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            label = "LOWER";
           /*
                      ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
                      │         │         │   UP    │         │    {    │                    │    }    │    7    │    8    │    9    │    +    │
            ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
            │   N/C   │         │  LEFT   │   DOWN  │  RIGHT  │    [    │                    │    ]    │    4    │    5    │    6    │    -    │   N/C   │
            ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
            │   N/C   │         │         │         │         │    (    ││   N/C  ││   N/C  ││    )    │    1    │    2    │    3    │    *    │   N/C   │
            └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┘╰────────╯╰────────╯└─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                          │         │         │         │   N/C   ││   N/C   │   CMD   │    0    │         │
                                          └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘
            */
            bindings = <
                      &trans    &trans    &kp UP    &trans     &kp LBRC                      &kp RBRC  &kp N7    &kp N8    &kp N9    &kp PLUS
            &trans    &trans    &kp LEFT  &kp DOWN  &kp RIGHT  &kp LBKT                      &kp RBKT  &kp N4    &kp N5    &kp N6    &kp MINUS &trans
            &trans    &trans    &trans    &trans    &trans     &kp LPAR    &trans  &trans    &kp RPAR  &kp N1    &kp N2    &kp N3    &kp STAR  &trans
                                          &trans    &trans     &trans      &trans  &trans    &kp LGUI  &kp N0    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };


        raise_layer {
            label = "RAISE";
            /*
                      ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
                      │   HOME  │    @    │    :    │    "    │    !    │                    │    #    │    '    │    ;    │    |    │         │
            ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
            │   N/C   │  PG_UP  │    ^    │    <    │    >    │    ?    │                    │   TAB   │    .    │    ,    │         │         │   N/C   │
            ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
            │   N/C   │  PG_DN  │    *    │    _    │    &    │    %    ││   N/C  ││   N/C  ││   DEL   │    /    │    $    │         │         │   N/C   │
            └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┘╰────────╯╰────────╯└─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                          │         │ ADJUST  │   ALT   │   N/C   ││   N/C   │         │         │         │
                                          └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘
            */
            bindings = <
                      &kp HOME  &kp AT    &kp COLON &kp DQT   &kp EXCL                       &kp HASH  &kp SQT   &kp SEMI  &kp PIPE  &trans
            &trans    &kp PG_UP &kp CARET &kp LT    &kp GT    &kp QMARK                      &kp TAB   &kp DOT   &kp COMMA &trans    &trans    &trans
            &trans    &kp PG_DN &kp STAR  &kp UNDER &kp AMPS  &kp PRCNT   &trans  &trans     &kp DEL   &kp FSLH  &kp DLLR  &trans    &trans    &trans
                                          &trans   &mo ADJUST &kp LALT    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adjust_layer {
            label = "ADJUST";
            /*
                      ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
                      │         │         │         │         │ BT CLR  │                    │ BT CLR  │         │         │         │         │
            ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
            │   N/C   │         │         │         │         │ BT NXT  │                    │ BT NXT  │         │         │         │         │   N/C   │
            ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
            │   N/C   │         │         │         │         │ BT PRV  ││   N/C  ││   N/C  ││ BT PRV  │         │         │         │         │   N/C   │
            └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┘╰────────╯╰────────╯└─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                          │         │         │         │   N/C   ││   N/C   │         │         │         │
                                          └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘
            */
            bindings = <
                      &trans    &trans    &trans    &trans   &bt BT_CLR                     &bt BT_CLR &trans    &trans    &trans    &trans
            &trans    &trans    &trans    &trans    &trans   &bt BT_NXT                     &bt BT_NXT &trans    &trans    &trans    &trans    &trans
            &trans    &trans    &trans    &trans    &trans   &bt BT_PRV &trans     &trans   &bt BT_PRV &trans    &trans    &trans    &trans    &trans
                                          &trans    &trans     &trans   &trans     &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
